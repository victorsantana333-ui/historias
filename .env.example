# Somente no servidor. Nunca use prefixo VITE_ nestas credenciais.
DEFLOW_API_KEY=
DEFLOW_API_SECRET=
# Opcional: vazio usa a carteira padrão da conta DeFlow.
DEFLOW_WALLET_ID=
# Gere uma vez com: openssl rand -hex 32. Preserve em reinícios.
PAYMENT_SIGNING_SECRET=
APP_ORIGIN=http://localhost:3000
PORT=3000

# Segredo da inscrição exibido uma vez no painel DeFlow (não é o API secret).
DEFLOW_WEBHOOK_SECRET=
# Disco persistente obrigatório na hospedagem. Apenas uma instância Node.
DATABASE_PATH=./data/donations.sqlite
